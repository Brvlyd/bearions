# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin, used to build links inside emails (no trailing slash).
# Covers the signup confirmation link and the password reset link alike.
#
# Also the canonical address published to search engines: <origin> goes into
# canonical/Open Graph URLs, robots.txt and sitemap.xml. Those fall back to the
# production domain (lib/site-url.ts DEFAULT_SITE_ORIGIN) rather than the
# request host, so a preview deployment never advertises itself as the site.
#
# Falls back to the origin the request came from when unset. That is why a
# confirmation email sent while running `npm run dev` links to localhost and is
# unopenable from a phone -- set this to the real domain on every deployment,
# and leave it unset (or set to http://localhost:3000) for local work.
#
# Whatever you put here, the matching <origin>/auth/confirm and
# <origin>/auth/reset-password must also be listed under Supabase ->
# Authentication -> URL Configuration -> Redirect URLs, otherwise Supabase
# silently rewrites the link to the project's Site URL.
NEXT_PUBLIC_SITE_URL=https://www.bearions.store

# Brevo (transactional email) Configuration
#
# These cover only the emails the app sends itself: forgot-password, contact form,
# and order notifications. Supabase auth emails (signup confirmation, magic link,
# change email) are sent by Supabase, not by this app, so they are NOT configured
# here -- put Brevo's SMTP credentials in the Supabase dashboard instead.
# See docs/setup/BREVO_SMTP_SUPABASE.md.
#
# API key: Brevo dashboard -> Settings -> SMTP & API -> API Keys (starts with xkeysib-)
BREVO_API_KEY=your-brevo-api-key
# Must be a sender verified in Brevo (Settings -> Senders, Domains & Dedicated IPs)
BREVO_SENDER_EMAIL=hello@bearion.com
BREVO_SENDER_NAME=Bearion
# Inbox that receives contact form submissions
CONTACT_RECEIVER_EMAIL=hello@bearion.com

# PayPal Configuration
# App credentials: PayPal Developer Dashboard -> Apps & Credentials
# PAYPAL_CLIENT_SECRET is server-only, never expose to the browser.
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is safe to expose (required by PayPal's JS SDK).
#
# All three MUST come from the same PayPal app. A sandbox client id against the
# live API base (or the reverse) fails confusingly: the button renders, then the
# order it creates cannot be found when the other side goes to capture it.
#
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is read by the browser, so it is baked into the
# bundle by `next build` — changing it means rebuilding the image, not just
# restarting the container. See the build args in docker-compose.yml.
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# https://api-m.sandbox.paypal.com for testing, https://api-m.paypal.com for live
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
#
# Testing against sandbox without taking the live store off PayPal: put the three
# sandbox values in `.env.development.local` instead of editing this file. Next.js
# gives that file priority for `next dev` and ignores it entirely for `next build`,
# so local testing runs on sandbox while the deployed image stays on live. The JS
# SDK URL needs no change — PayPal picks the environment from the client id.

# Shared secret for POST /api/paypal/reconcile, the scheduled sweep that finishes
# payments the customer approved but whose capture never reached us (closed tab,
# dropped connection). Point a scheduler at it every 15-30 minutes with header:
# x-sync-secret: <this value>. Without it the route answers 503 and stays off.
PAYPAL_SYNC_SECRET=

# Shipping (optional — the store works without any of these)
#
# Without BITESHIP_API_KEY the rate engine prices from the zone table in the CMS
# (Admin -> Pengiriman), which needs no account and always answers. Set the key
# and switch the provider to "biteship" in the CMS for live multi-courier rates
# and real courier tracking scans.
#
# Note that /v1/rates and /v1/trackings are billed per call: a Biteship account
# with no balance answers 400 on both, and the store silently falls back to the
# zone table. Admin -> Pengiriman shows which of the two is happening.
# Key: Biteship dashboard -> Settings -> API Keys
BITESHIP_API_KEY=

# Shared secret for POST /api/shipping/sync-tracking, the scheduled job that
# refreshes tracking for parcels in flight. Point Supabase Cron or Vercel Cron at
# that route once or twice a day with header: x-sync-secret: <this value>.
SHIPPING_SYNC_SECRET=

# Shared secret Biteship sends on POST /api/webhooks/biteship, so a scan updates
# the customer's timeline immediately instead of waiting for the next cron run.
BITESHIP_WEBHOOK_SECRET=
